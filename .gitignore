# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Match Optimizer ---
# Raw source archives and extracted datasets (large; rebuild with npm run data:build)
/data/raw/
# Offline feature matrices (regenerated by npm run data:features)
/data/processed/features_*.csv
# Local demo store and Python env
/.data/
/.venv/
__pycache__/
*.tmp
.env*.local
!.env.example

# Local tooling
/.claude/
/ml/__pycache__/
