# ---------------------------------------------------------------------------------------------
# BOUNDARY / Match Optimizer — environment variables. Copy to .env.local and fill in.
# Never commit real values. Anything without NEXT_PUBLIC_ stays on the server.
# With nothing set, the app runs in clearly-labelled DEMO MODE (local store, simulated clock).
# ---------------------------------------------------------------------------------------------

# Brand (placeholder name, configurable)
NEXT_PUBLIC_BRAND_NAME=BOUNDARY

# Supabase (storage + auth). All three are required to leave demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose
SUPABASE_DB_SCHEMA=boundary            # tables live in their own schema; expose it under Project Settings → Data API
ADMIN_USER_IDS=                        # comma-separated Supabase user ids allowed to run pipeline/learning admin actions

# Gemini (explanations only; validity and scores are deterministic). Check current ids at
# https://ai.google.dev/gemini-api/docs/models — e.g. gemini-3.8-flash was listed as GA on 2026-10-11.
GEMINI_API_KEY=
GEMINI_MODEL=

# Background pipeline
CRON_SECRET=                           # required by /api/cron/pipeline (Authorization: Bearer <CRON_SECRET>)
PIPELINE_CLOCK=                        # "real" | "simulated". Default: real if a provider is configured, else simulated
DEMO_SIM_START=2026-05-16T00:00:00.000Z
SIM_AUTO_ADVANCE_MINUTES=30            # simulated minutes per scheduler tick (simulated clock only)

# Cricket data provider (optional). Only authorised APIs; no consumer-app scraping.
CRICKET_PROVIDER=none                  # "free" (Wikipedia schedule + ESPNcricinfo live RSS; zero cost, no keys), "google-search" (Gemini grounding) or "cricapi"
FIXTURE_SCHEDULE_TTL_MIN=360           # how often the free provider re-reads Wikipedia (24h when nothing is scheduled)
CRICAPI_KEY=

# Zero-cost guards (hard daily caps; calls beyond them are skipped, never made)
GOOGLE_SEARCH_MAX_PER_DAY=20
GEMINI_MAX_EXPLANATIONS_PER_DAY=100
GOOGLE_SEARCH_DISCOVERY_TTL_MIN=360    # re-search fixtures at most this often (24h when nothing was found)

# Weather (Open-Meteo needs no key)
WEATHER_PROVIDER=open-meteo

# Reminders. Real sending only when NOTIFICATIONS_LIVE=true and the provider keys are set.
NOTIFICATIONS_LIVE=false
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional overrides
RULES_DEFAULT_IPL=kaggle-ipl-legacy-inferred
RULES_DEFAULT_WPL=kaggle-ipl-legacy-inferred
TEAM_RULES_DEFAULT=
LOCAL_STORE_PATH=                      # demo store file (default .data/demo-store.json; /tmp on Vercel)
PROCESSED_DATA_DIR=                    # default ./data/processed
